{
  "name": "trucksim-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TruckSim Command Center: personal companion for Euro Truck Simulator 2 and American Truck Simulator.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trucksim/web",
    "bridge": "npm run start -w @trucksim/bridge",
    "bridge:demo": "npm run demo -w @trucksim/bridge",
    "build": "npm run build -w @trucksim/web",
    "test": "node --test \"packages/core/test/*.test.ts\" \"apps/bridge/test/*.test.ts\"",
    "typecheck": "tsc -p packages/core && tsc -p apps/bridge && tsc -p apps/web",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "koffi@2.16.4": true,
    "esbuild@0.28.2": true
  }
}
