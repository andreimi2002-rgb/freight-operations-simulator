---
// Tabs between the cargo, trailer and truck catalogs.
import { getI18n } from '../i18n/index.mjs';

interface Props { active: 'cargo' | 'trailers' | 'trucks' }
const { active } = Astro.props;
const { t } = getI18n();
const tabs = [
  { id: 'cargo', href: '/ats/cargo' },
  { id: 'trailers', href: '/ats/trailers' },
  { id: 'trucks', href: '/ats/trucks' },
];
---
<nav class="tabs" aria-label={t('catalog.tabsLabel')}>
  {tabs.map((tab) => (
    <a href={tab.href} class="tab" aria-current={tab.id === active ? 'page' : undefined}>{t(`catalog.tabs.${tab.id}`)}</a>
  ))}
</nav>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tab {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-input);
    border-radius: 999px;
    color: var(--text-soft);
    text-decoration: none;
    font-weight: 600;
  }
  .tab:hover { color: var(--text); border-color: var(--text-muted); }
  .tab[aria-current='page'] { background: var(--amber); color: var(--on-amber); border-color: var(--amber); }
</style>
