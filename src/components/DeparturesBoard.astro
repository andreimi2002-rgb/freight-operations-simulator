---
// Airport-style departures board. The rows are generated in the browser by
// src/scripts/board.mjs (same city + local hour → same jobs for everyone).
import { getI18n } from '../i18n/index.mjs';

interface Props { city?: string; featured?: boolean }
const { city, featured = false } = Astro.props;
const { t, meta } = getI18n();
const columns = ['time', 'cargo', 'from', 'to', 'distance', 'trailer', 'weight'];
---
<section
  class="board"
  aria-labelledby="board-title"
  data-board-city={city}
  data-board-featured={featured ? '' : undefined}
  data-locale={meta.intlLocale}
  data-state="loading"
>
  <header class="board-head">
    <h2 id="board-title" class="board-title">{t('board.title')}</h2>
    <p class="board-sub soft" data-board-subtitle></p>
  </header>
  <div class="table-scroll">
    <table>
      <caption class="visually-hidden"></caption>
      <thead>
        <tr>
          {columns.map((col) => <th scope="col">{t(`board.cols.${col}`)}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr><td class="empty" colspan={columns.length}><span class="empty-text">{t('board.loading')}</span></td></tr>
      </tbody>
    </table>
  </div>
  <p class="board-error soft">{t('board.error')}</p>
  <p class="board-note muted">{t('board.estimateNote')}</p>
</section>

<script>
  import '../scripts/board.mjs';
</script>

<style>
  .board {
    background: var(--bg-header);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .board-title {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .board-sub { font-size: 14px; }
  .board-sub :global(a) { color: var(--text); }
  table {
    width: 100%;
    min-width: 980px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--row-line);
    white-space: nowrap;
  }
  /* Rows are created by the board script, so cell rules are global inside the board. */
  .board :global(td) { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--row-line); vertical-align: top; }
  .board :global(tbody tr:last-child td) { border-bottom: 0; }
  .board :global(tbody tr:hover td) { background: var(--panel-deep); }
  .board :global(td small) { display: block; color: var(--text-muted); font-size: 12px; margin-top: 2px; }
  :global(.b-time) { font-family: var(--font-mono); font-weight: 600; color: var(--amber); white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.b-time small) { color: var(--text-muted); font-weight: 400; }
  :global(.b-cargo-name) { font-weight: 600; display: block; color: var(--text); }
  :global(a.b-cargo-name:hover) { color: var(--amber); }
  .board :global(tr.is-not-owned td) { opacity: 0.55; }
  :global(.badge.not-owned) { margin-top: 4px; color: var(--text-muted); }
  :global(.badge.urgency-important) { color: var(--amber); border-color: color-mix(in srgb, var(--amber) 50%, var(--border)); }
  :global(.badge.urgency-urgent) { color: #ff8a7a; border-color: color-mix(in srgb, #ff8a7a 55%, var(--border)); }
  :global(.job-badges) { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  :global(.job-badges .badge) { font-size: 11px; padding: 1px 6px; }
  :global(.b-to a) { color: var(--text); font-weight: 600; }
  :global(.b-to a:hover) { color: var(--amber); }
  :global(.b-dist), :global(.b-weight) { font-family: var(--font-mono); white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.b-from), :global(.b-trailer) { color: var(--text-soft); }
  .board :global(.empty) { color: var(--text-soft); padding: var(--space-6) var(--space-5); }
  .board :global(.empty-text) {
    position: sticky;
    left: var(--space-5);
    display: inline-block;
    max-width: calc(100vw - 2 * var(--gutter) - 2 * var(--space-5));
  }
  .board-error { display: none; padding: 0 var(--space-5) var(--space-4); }
  .board[data-state='error'] .board-error { display: block; }
  .board[data-state='error'] tbody { display: none; }
  .board-note { padding: var(--space-3) var(--space-5) var(--space-4); font-size: 12px; border-top: 1px solid var(--row-line); }
</style>
