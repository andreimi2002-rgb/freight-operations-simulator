---
import Logo from './Logo.astro';
import GameSwitch from './GameSwitch.astro';
import UnitToggle from './UnitToggle.astro';
import DlcDialog from './DlcDialog.astro';
import SearchBox from './SearchBox.astro';
import { getI18n } from '../i18n/index.mjs';

const { t } = getI18n();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: t('nav.home') },
  { href: '/ats', label: t('nav.cities') },
  { href: '/ats/map', label: t('nav.map') },
  { href: '/ats/companies', label: t('nav.companies') },
  { href: '/ats/cargo', label: t('nav.cargo') },
  { href: '/ats/planner', label: t('nav.planner') },
  { href: '/about', label: t('nav.about') },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={t('a11y.home')}>
      <Logo />
      <span class="brand-name">{t('site.name')}</span>
    </a>
    <div class="header-tools">
      <nav aria-label={t('nav.label')}>
        <ul class="nav-list">
          {links.map((link) => (
            <li>
              <a
                class="nav-link"
                href={link.href}
                aria-current={path === link.href ? 'page' : (link.href === '/ats' && path.startsWith('/ats/') && !/^\/ats\/(planner|compan|map|mission|cargo|trailer|truck)/.test(path) ? 'true' : (link.href === '/ats/companies' && path.startsWith('/ats/company/') ? 'true' : (link.href === '/ats/cargo' && /^\/ats\/(cargo\/|trailer|truck)/.test(path) ? 'true' : undefined)))}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <SearchBox />
      <a class="saved-link" href="/saved" aria-current={path === '/saved' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <span>{t('saved.navLink')}</span>
      </a>
      <GameSwitch />
      <UnitToggle />
      <button type="button" class="dlc-open" data-dlc-open>{t('dlcs.button')} <span class="dlc-count mono" data-dlc-count></span></button>
    </div>
  </div>
</header>
<DlcDialog />

<style>
  .saved-link { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--target); padding: 0 var(--space-3); border: 1px solid var(--border-input); border-radius: var(--radius-md); background: var(--panel-deep); color: var(--text-soft); font: 500 14px var(--font-sans); text-decoration: none; }
  .saved-link:hover, .saved-link[aria-current='page'] { color: var(--amber); border-color: var(--amber); }
  .saved-link svg { width: 18px; height: 18px; }
  @media (max-width: 559px) { .saved-link span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .site-header {
    background: var(--bg-header);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    color: var(--text);
    text-decoration: none;
  }
  .brand-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .header-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .dlc-open { min-height: var(--target); padding: 0 var(--space-3); background: var(--panel-deep); color: var(--text); border: 1px solid var(--border-input); border-radius: var(--radius-md); font: 600 14px var(--font-sans); cursor: pointer; }
  .dlc-open:hover { border-color: var(--amber); }
  .dlc-count:not(:empty) { margin-left: 4px; padding: 0 6px; border-radius: 999px; background: var(--amber); color: var(--on-amber); font-size: 12px; }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav-link:hover { color: var(--text); background: var(--panel); }
  .nav-link[aria-current] { color: var(--text); box-shadow: inset 0 -2px 0 var(--amber); border-radius: 0; }

  @media (max-width: 559px) {
    .header-tools { width: 100%; justify-content: space-between; }
    nav { width: 100%; }
    .nav-list { flex-wrap: wrap; column-gap: 0; }
    .nav-link { padding: 0 var(--space-2); font-size: 14px; }
  }
</style>
