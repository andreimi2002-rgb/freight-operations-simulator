---
// US / metric switch. The live script (src/scripts/live.mjs) wires it up and remembers the choice.
import { getI18n } from '../i18n/index.mjs';

const { t } = getI18n();
---
<div class="units" role="group" aria-label={t('units.label')}>
  <button type="button" data-units="us" aria-pressed="true" title={t('units.usLong')}>{t('units.us')}</button>
  <button type="button" data-units="metric" aria-pressed="false" title={t('units.metricLong')}>{t('units.metric')}</button>
</div>

<style>
  .units {
    display: inline-flex;
    padding: 3px;
    gap: 3px;
    background: var(--panel-deep);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-md);
  }
  button {
    min-height: var(--target);
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text-muted);
    font: 600 13px var(--font-mono);
    cursor: pointer;
  }
  button:hover { color: var(--text); }
  button[aria-pressed='true'] { background: var(--panel); color: var(--text); box-shadow: inset 0 0 0 1px var(--border-input); }
</style>
