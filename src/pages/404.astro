---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n } from '../i18n/index.mjs';

const { t } = getI18n();
---
<BaseLayout title={t('notFound.title')}>
  <div class="container not-found">
    <p class="eyebrow mono">404</p>
    <h1>{t('notFound.title')}</h1>
    <p class="soft">{t('notFound.text')}</p>
    <a class="button button-primary" href="/">{t('notFound.back')}</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-top: var(--space-8);
  }
  h1 { font-size: 36px; }
</style>
