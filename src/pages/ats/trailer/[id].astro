---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SaveButton from '../../../components/SaveButton.astro';
import { getI18n } from '../../../i18n/index.mjs';
import { trailers, cargo } from '../../../lib/data.mjs';
import { cargoPath } from '../../../lib/catalog.mjs';

export function getStaticPaths() {
  return trailers.map((x) => ({ params: { id: x.id }, props: { trailerId: x.id } }));
}

const { t } = getI18n();
const tr = trailers.find((x) => x.id === Astro.props.trailerId);
const cargoById = new Map(cargo.map((c) => [c.id, c]));
const list = tr.cargo.map((id) => cargoById.get(id)).filter(Boolean).sort((a, b) => a.name.localeCompare(b.name));
const price = (m) => (m.priceUsd != null ? `$${m.priceUsd.toLocaleString('en-US')}` : (m.pricesUsd ?? []).map((p) => `$${p.toLocaleString('en-US')}`).join(' / '));
---
<BaseLayout title={`${tr.name} trailer`} description={t('trailerPage.meta', { name: tr.name })} crumbs={[[t('trailerPage.breadcrumb'), '/ats/trailers'], [tr.name, Astro.url.pathname]]}>
  <div class="container crumbs-row">
  <nav class="crumbs" aria-label={t('trailerPage.breadcrumb')}>
    <a href="/ats/trailers">{t('trailerPage.breadcrumb')}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{tr.name}</span>
  </nav>
    <SaveButton type="trailer" name={tr.name} />
  </div>
  <div class="container page">
    <h1>{tr.name}</h1>

    <section aria-labelledby="models-title">
      <h2 id="models-title">{t('trailerPage.modelsTitle')}</h2>
      {tr.models.length === 0
        ? <p class="muted">{t('trailerPage.noModels')}</p>
        : <ul class="models">
            {tr.models.map((m) => (
              <li class="card-deep model">
                <span class="name">{m.name}</span>
                {price(m) && <span class="mono">{t('trailerPage.price')}: {price(m)}</span>}
                <span class="small soft">{m.ownable === true ? t('trailerPage.buyable') : m.ownable === false ? t('trailerPage.notBuyable') : ''}{m.articulated ? ` · ${t('trailerPage.articulated')}` : ''}</span>
                {m.wiki && <a class="small" href={m.wiki.url} rel="noopener">{t('trailerPage.wikiLink')}</a>}
              </li>
            ))}
          </ul>}
    </section>

    <section aria-labelledby="cargo-title">
      <h2 id="cargo-title">{t('trailerPage.cargoTitle', { n: list.length })}</h2>
      <ul class="chips">
        {list.map((c) => <li><a class="chip-link" href={cargoPath(c)}>{c.name}</a></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; font-size: 14px; color: var(--text-muted); }
  .crumbs a { display: inline-flex; align-items: center; min-height: var(--target); color: var(--text-soft); }
  .page { display: grid; gap: var(--space-6); padding-top: var(--space-4); }
  .page > * { min-width: 0; }
  h1 { font-size: clamp(30px, 5vw, 46px); }
  h2 { margin-bottom: var(--space-3); }
  .small { font-size: 13px; }
  .models { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .model { display: grid; gap: 4px; }
  .name { font-weight: 600; font-size: 17px; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .chip-link { display: inline-flex; align-items: center; min-height: var(--target); padding: 0 var(--space-3); border: 1px solid var(--border-input); border-radius: 999px; background: var(--panel-deep); color: var(--text); text-decoration: none; font-size: 14px; }
  .chip-link:hover { border-color: var(--amber); color: var(--amber); }
</style>
